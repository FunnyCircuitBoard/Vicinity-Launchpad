// Cloudflare settings for Vicinity.
// "main" = backend code. "assets" = public website files.
// "build" runs before every deploy: fonts and the QR library are copied in, pages are built,
// then every test must pass.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vicinity-map",
  "account_id": "bb77f7451b478e895fa1efb10aaccc35",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Off: the workers.dev address served the whole site (admin included) outside the vicinity.city protections,
  // and sign-in cannot work there anyway. Turn it back on only for a short test.
  "workers_dev": false,
  "preview_urls": false,
  "build": { "command": "npm run build" },
  // Public settings, versioned here so a change goes through a pull request. Everything secret
  // (SOLANA_RPC_URL, RESEND_API_KEY, GOOGLE_CLIENT_SECRET, ...) stays in Cloudflare as a Secret and is
  // never touched by a deploy. keep_vars: plain-text settings added in the Cloudflare dashboard
  // (for example ADMIN_WALLETS) are kept by a deploy instead of being deleted.
  "keep_vars": true,
  "vars": {
    // "preview" shows the purple TEST ENVIRONMENT banner and the post-launch state of the site;
    // "live" is the real site (countdown until the Launchpad opens, no banner, no test lab seeding).
    "SITE_MODE": "live",
    "GOOGLE_CLIENT_ID": "508878292080-h05nh9h4p6u4ajpqldc423f6elmqc0nl.apps.googleusercontent.com",
    "EMAIL_FROM": "Vicinity <noreply@vicinity.city>",
    // The one official $VICINITY contract (Raydium LaunchLab, launched 3 Oct 2026 at 16:48 UTC). Verified on-chain before it
    // was set here: classic SPL token, 1,000,000,000 supply, 6 decimals, mint authority and freeze authority both removed,
    // metadata "VICINITY CITY" / VICINITY. The checker, the registry, the holder list, the balance history and every "Buy"
    // link read it. (An address set earlier the same day, 2e8VdgpT27LcNWyfk5Ce6ZyGwMdu7ajaSnMph83Xwray, was the owner's
    // test coin and was removed within hours.) Empty would mean "not launched": countdown, no links, every address unofficial.
    "VICINITY_MINT": "2aVkhRfAEm44tMhFo8oamWvumGGvweFqnUwukRMBkray",
    // The owner's admin wallet (full rights in /admin), set by the owner on 3 Oct 2026. It replaces the wallet that was set
    // in the Cloudflare dashboard before; a value here wins over the dashboard on every deploy. Several wallets: separate
    // them with commas. Change it only through a pull request (do not delete the line: keep_vars would keep the old value).
    "ADMIN_WALLETS": "13qRam63xqqd8KNUoAmHWQu7ro71oHqEsYHYaG5MsRiN",
    // The new sign-up (location → account with Google or e-mail + password → wallet → dashboard), on since 3 Oct 2026.
    // Any other value (change it, do not delete the line: keep_vars would keep the old value) brings the old sign-up back at the next deploy.
    "SIGNUP_FLOW": "v2",
    // Member profiles, the Launchpad's city-coin list and the tabbed dashboard: all on since 3 Oct 2026 (the owner's
    // "launch everything live"). Any other value than "on" (change it, do not delete the line: keep_vars) turns one off.
    "PROFILES": "on",
    "LAUNCHPAD_V2": "on",
    "DASHBOARD_V2": "on",
    // Buy and swap inside the site (the Buy panel on /token, the dashboard, /coin and the Launchpad cards; /api/swap/*): on
    // since 9 Oct 2026, by the owner ("turn the swap on"). Routed by Jupiter, signed in the person's own wallet, no platform
    // fee. Any other value than "on" (change it, do not delete the line: keep_vars) hides the panel and brings the old
    // "Buy on Raydium" links back at the next deploy. City coins on their bonding curve: LAUNCHPAD_TRADING below (PR-2).
    "SWAP": "on",
    // Jupiter's allowance for our key (portal.jup.ag, Free plan on 10 Oct 2026: 1 request every 2 seconds). The Worker spends at
    // most this many exact builds per second per server and shows estimates beyond it; raise it with the plan (e.g. "10").
    "JUPITER_RPS": "0.5",
    // City coins on mainnet, setup stage (PR-1, 10 Oct 2026). The owner deployed both programs from his Mac on 10 Oct 2026
    // (build: solana/release/mainnet-2026-10-10, PR #49) and both upgrade authorities are his 2-of-3 Squads vault
    // AB5qB1iAukPB7p1dkukQ1qSke3yQBDeSd5o69dLFGs7X. These three settings open ONLY the owner's City coins tab in /admin, the
    // /api/lp/* routes and /coin-meta (src/cluster.js lpSetup). City-coin trading stays off until LAUNCHPAD_DBC_CONFIGS,
    // LAUNCHPAD_LOOKUP_TABLE and LAUNCHPAD_TRADING are set by PR-2, after the owner's setup and the preflight
    // (docs/MAINNET.md section 4). Change them only by a pull request (do not delete the lines: keep_vars).
    "LAUNCHPAD_CLUSTER": "mainnet",
    "LAUNCHPAD_PROGRAM_ID": "AkMP9qvAYmb8Vyu63Qhw8Z4ee1fgQbCRKkXWy5r5A1Ai",
    "LAUNCHPAD_REWARDS_PROGRAM_ID": "EVwxp3V9YSvsyDEjp39B9wRDQxHR2xF2CNeR8AMRYrgG",
    // The priority fee every City-coins transaction built here carries (micro-lamports per compute unit; capped in src/lpkit.js
    // so it never passes 0.01 SOL). It must be set: a transaction WITHOUT one is changed by Phantom (it adds its own fee), and the
    // site then refuses the changed bytes ("Your wallet changed the transaction", the owner's setup step 1, 11 Oct 2026). 100000
    // costs 0.000005 SOL at 50,000 units and 0.00004 SOL at 400,000. Curve trades (src/lptrade.js) read the same setting.
    "LAUNCHPAD_CU_PRICE": "100000",
    // City coins on mainnet, trading (PR-2, 12 Oct 2026; the owner: "Yes, switch it on now"). The owner finished the City
    // coins tab's setup on 12 Oct 2026 (steps 1-7, signed by 13qRam…MsRiN; both programs' upgrade authority is the Squads
    // vault AB5q…LFGs7X). The read-only preflight against his "Send this to the team" summary: 51 rows, 44 pass, 7 warn (keys
    // that live in Cloudflare, not in the shell), 0 fail. The price curve is byte for byte Meteora's config for Vicinity's
    // defaults (solana/sdk/launchpad/config.mjs: 85 SOL target, 1.25 % fee and 0.05 SOL launch fee on the live config today; the
    // site reads every fee figure it shows from this config, src/fees.js), allow-listed by 6voKQ4…AiY75; the
    // speed table holds the 21 addresses the launch, graduation and fee transactions share. Rollback: LAUNCHPAD_TRADING "off"
    // stops the curve trade routes at the next deploy (change the lines, do not delete them: keep_vars).
    // LAUNCHPAD_DBC_CONFIGS: only add configs (comma-separated), never remove one a coin launched on: src/officialcoins.js leaves out
    // every coin whose pool runs on a config not listed here (/official-coins.csv is made for Jupiter's token tags, so a removed
    // config would drop those coins' tags). The first one is the live config, the one new launches use.
    "LAUNCHPAD_DBC_CONFIGS": "EZVHCgxKZhvXmUGMXJMEw8tZHiTmoHPyM9mNNQ5u1kSP",
    "LAUNCHPAD_LOOKUP_TABLE": "u2V4Y3KagE2nBZ1656sL4XsV3K7iAZ5C7cQV475DEZ5",
    "LAUNCHPAD_TRADING": "on",
    // In-app notices (src/flags.js notifyOn): a Notifications tab on the dashboard (replies, moderation outcomes, your coin picture's
    // review, founder windows and verdicts, elections), with per-kind controls. No e-mail, no push. ON since 17 Oct 2026, by the owner
    // ("switch on all the builds"). To switch off: "off" (change the value, do not delete the line: keep_vars) in a pull request;
    // anything else than "on" is the site exactly as before.
    "NOTIFY": "on",
    // Send from the dashboard's Wallet tab (src/flags.js walletSendOn, src/walletsend.js): SOL, $VICINITY or a city coin from the linked
    // wallet to an address the person types; the Worker builds and checks, the person's own wallet signs, nothing is held here. ON since
    // 17 Oct 2026, by the owner ("switch on all the builds"). To switch off: "off" (change the value, do not delete the line: keep_vars)
    // in a pull request; anything else than "on" is the Wallet tab exactly as before (no Send button, the three /api/wallet/send/* paths
    // answer 404 like any unknown path).
    "WALLET_SEND": "on",
    // Community feed v2 (src/flags.js feedV2On): the "update" post kind, delete your own post, mute, the author's city on every
    // national post, one confirmation before the first national post. ON since 17 Oct 2026, by the owner ("switch on all the
    // builds"). To switch off: "off" (change the value, do not delete the line: keep_vars) in a pull request; anything else than
    // "on" is the feed exactly as before.
    "FEED_V2": "on"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // The Worker runs first only for /api/*, /coin-meta/* and /official-coins.csv (the official city coins read from the chain,
    // src/officialcoins.js), which are handled in code. Pages and files are served straight
    // from the static assets (free, no Worker call) and get their security headers from public/_headers.
    // (To also forward www / old addresses and force https from inside the Worker, set this to true:
    // every request then counts as a Worker request, which matters on the free plan.)
    "run_worker_first": ["/api/*", "/coin-meta/*", "/official-coins.csv"],
    "not_found_handling": "404-page"
  },
  // vicinity.city is the site. The others forward to it (src/index.js).
  // vicinitycity.net and www.vicinitycity.net go back in here once their old DNS records are deleted
  // (until then Cloudflare refuses them and the whole deploy fails).
  "routes": [
    { "pattern": "vicinity.city", "custom_domain": true },
    { "pattern": "www.vicinity.city", "custom_domain": true }
  ],
  // The database; the code creates and upgrades its tables the first time they're used.
  "d1_databases": [{ "binding": "DB", "database_name": "vicinity-claims", "database_id": "e0e01286-ca8f-49dd-82c0-638fa24abb40" }],
  // Every 10 minutes: balance history, founder seats, elections, moderation expiry, snapshots (src/jobs.js)
  "triggers": { "crons": ["*/10 * * * *"] },
  "observability": { "enabled": true }
}
