{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022", "dom"],
    "types": ["mocha", "node"],
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tests/**/*.ts", "sdk/**/*.ts", "sdk/**/*.mjs", "scripts/**/*.ts"],
  "exclude": ["node_modules", "target"],
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "ignore": ["(?:^|/)node_modules/", "\\.mjs$"]
  }
}
