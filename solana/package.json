{
  "name": "vicinity-rewards-solana",
  "private": true,
  "version": "0.1.0",
  "description": "Vicinity Rewards: SDK (Merkle, PDAs, instruction builders), Anchor tests and the auditor demo for the vicinity_rewards Solana program.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--no-experimental-strip-types ts-mocha -p ./tsconfig.json -t 1000000 tests/**/*.ts",
    "sdk-test": "node --test sdk/*.test.mjs",
    "sdk-fixtures": "node sdk/fixtures/generate.mjs && node sdk/gen-fixtures.mjs",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "demo": "NODE_OPTIONS=--no-experimental-strip-types ts-node -P ./tsconfig.json --transpile-only scripts/demo.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.31.1",
    "@solana/spl-token": "^0.4.13",
    "@solana/web3.js": "^1.98.0"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.0",
    "chai": "^4.5.0",
    "mocha": "^10.8.2",
    "ts-mocha": "^11.1.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0"
  }
}
